# Asset-free regression: evaluate actual registration rules, not shader bodies.
cmake_minimum_required(VERSION 3.22)
if(NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()
file(READ "${SOURCE_DIR}/CMakeLists.txt" root_rules)
if(NOT root_rules MATCHES "option\\(STARFOX_ENABLE_EXPERIMENTAL_REFLECTION_INDEX[ \t\r\n]+\"[^\"]*\"[ \t\r\n]+OFF\\)")
    message(FATAL_ERROR "Experimental reflection shaders must default OFF")
endif()
file(READ "${SOURCE_DIR}/cmake/DisplayXR.cmake" rules)
string(FIND "${rules}" "if(STARFOX_DXC AND STARFOX_ENABLE_EXPERIMENTAL_REFLECTION_INDEX)" first)
string(FIND "${rules}" "if(MINGW AND EXISTS" last)
if(first LESS 0 OR last LESS_EQUAL first)
    message(FATAL_ERROR "Reflection registration anchors changed")
endif()
math(EXPR length "${last}-${first}")
string(SUBSTRING "${rules}" ${first} ${length} registrations)
function(target_sources)
endfunction()
function(target_include_directories)
endfunction()
function(target_compile_definitions)
endfunction()
function(add_custom_command)
    get_property(count GLOBAL PROPERTY registration_count)
    math(EXPR count "${count}+1")
    set_property(GLOBAL PROPERTY registration_count ${count})
endfunction()
set(STARFOX_DXC unused-compiler)
foreach(enabled IN ITEMS OFF ON)
    set(STARFOX_ENABLE_EXPERIMENTAL_REFLECTION_INDEX ${enabled})
    set_property(GLOBAL PROPERTY registration_count 0)
    cmake_language(EVAL CODE "${registrations}")
    get_property(count GLOBAL PROPERTY registration_count)
    if(enabled AND NOT count EQUAL 42)
        message(FATAL_ERROR "Opt-in must retain all 42 source/capture shaders, got ${count}")
    elseif(NOT enabled AND NOT count EQUAL 0)
        message(FATAL_ERROR "Release registered ${count} experimental shaders")
    endif()
endforeach()
message(STATUS "Release excludes experimental shaders; explicit opt-in preserves all 42")
